{
  "rewrites": [
    { "source": "/", "has": [{ "type": "query", "key": "g" }], "destination": "/api/share" },
    { "source": "/", "destination": "/meshygradient.html" }
  ],
  "functions": {
    "api/share.js": { "includeFiles": "meshygradient.html" }
  },
  "headers": [
    {
      "source": "/videos/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    }
  ]
}
